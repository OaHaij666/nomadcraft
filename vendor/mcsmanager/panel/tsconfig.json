{
  "compilerOptions": {
    "skipLibCheck": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "module": "commonjs",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2018",
    "moduleResolution": "node",
    "sourceMap": true,
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@languages/*": [
        "../languages/*"
      ],
      "mcsmanager-common": [
        "../common/src/index.ts"
      ],
      "*": [
        "node_modules/*",
        "src/types/*"
      ]
    },
    "lib": [
      "ES2022"
    ],
    "typeRoots": [
      "../../kamucl/node_modules/@types",
      "node_modules/@types"
    ],
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*",
    "../common/global.d.ts"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "test/**"
  ]
}

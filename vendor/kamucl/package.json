{
  "name": "kamucl-nc",
  "productName": "KAMUCL NC",
  "version": "0.1.0",
  "description": "KAMUCL NC - NomadCraft Minecraft desktop client",
  "homepage": "https://github.com/OaHaij666/nomadcraft",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "test": "node --require ./tests/helpers/electron-app.cjs --import tsx --test --test-timeout=120000 tests/all.test.ts",
    "start": "electron-vite preview",
    "dist": "npm run dist:win",
    "dist:win": "npm run build && electron-builder --win portable --x64 --publish never && node scripts/pack-windows-zip.cjs",
    "dist:mac": "node scripts/pack-mac.mjs",
    "dist:linux": "node scripts/pack-linux.cjs",
    "prepare:harmonyos": "node scripts/prepare-harmonyos.cjs",
    "dist:harmonyos": "node scripts/build-harmonyos.cjs",
    "verify:harmonyos": "node scripts/verify-harmonyos.cjs",
    "dist:all": "node scripts/dist-platform.cjs",
    "license:check": "node scripts/check-licenses.cjs"
  },
  "build": {
    "appId": "com.nomadcraft.kamucl.nc",
    "productName": "KAMUCL NC",
    "directories": {
      "output": "../../.nomad/releases/0.1.0"
    },
    "files": [
      "out/main/**",
      "out/preload/**",
      "out/renderer/**",
      "package.json",
      "!out/**/*.map",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "licenses/**",
      "docs/CORRESPONDING_SOURCE.md",
      "!out/renderer/nomad-panel/stats.html",
      "!out/renderer/nomad-panel/**/*.map"
    ],
    "asar": true,
    "compression": "maximum",
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "asarUnpack": [
      "out/main/WindowMaterial.exe",
      "out/main/GameWindowFocus.exe",
      "out/main/MacGameWindow",
      "out/main/LinuxGameWindow",
      "out/main/kamucl-bridge.jar",
      "out/main/kamucl-offline-skin.jar",
      "out/main/ysm-runtime/**",
      "out/main/nomad-agent*",
      "out/main/nomad-numen-adapter*.jar",
      "out/main/kamucl-bridge-*.jar",
      "out/main/ForgeClientResetPacket-0.3.1.jar"
    ],
    "beforePack": "scripts/portable-build-hook.cjs",
    "afterPack": "scripts/verify-windows-runtime.cjs",
    "win": {
      "files": [
        "out/main/**",
        "out/preload/**",
        "out/renderer/**",
        "package.json",
        "!out/**/*.map",
        "LICENSE",
        "THIRD_PARTY_NOTICES.md",
        "licenses/**",
        "docs/CORRESPONDING_SOURCE.md",
        "!node_modules/koffi/doc{,/**}",
        "!node_modules/koffi/lib{,/**}",
        "!node_modules/koffi/vendor{,/**}",
        "!node_modules/koffi/cnoke.cjs",
        "!node_modules/undici/docs{,/**}",
        "!out/renderer/nomad-panel/stats.html",
        "!out/renderer/nomad-panel/**/*.map"
      ],
      "target": [
        "portable",
        "zip"
      ],
      "artifactName": "KAMUCL-NC-${version}-windows-${arch}.${ext}",
      "icon": "build/icon.png"
    },
    "portable": {
      "unpackDirName": false,
      "artifactName": "KAMUCL-NC-${version}.exe"
    },
    "appImage": {
      "executableArgs": []
    },
    "mac": {
      "minimumSystemVersion": "13.0.0",
      "target": [
        "zip"
      ],
      "category": "public.app-category.games",
      "icon": "build/icon-512.png",
      "identity": null,
      "artifactName": "KAMUCL-NC-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "maintainer": "kamubaba-i <325699197+kamubaba-i@users.noreply.github.com>",
      "target": [
        "AppImage",
        "deb",
        "tar.gz"
      ],
      "category": "Game",
      "executableName": "kamucl",
      "icon": "build/icon-512.png",
      "artifactName": "KAMUCL-NC-${version}-linux-${arch}.${ext}",
      "desktop": {
        "entry": {
          "Name": "KAMUCL NC",
          "Comment": "Minecraft launcher",
          "Categories": "Game;",
          "StartupWMClass": "KAMUCL"
        }
      },
      "synopsis": "Minecraft launcher"
    }
  },
  "dependencies": {
    "@iarna/toml": "2.2.5",
    "adm-zip": "^0.6.0",
    "koffi": "^3.2.1",
    "undici": "^6.28.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^22.9.0",
    "@types/three": "0.185.0",
    "@types/ws": "8.18.1",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "asar": "^3.2.0",
    "electron": "44.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "minecraft-data": "3.117.0",
    "sharp": "^0.35.4",
    "skinview-utils": "0.7.1",
    "three": "^0.185.1",
    "tsx": "^4.23.13",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vue": "^3.5.13",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "license": "SEE LICENSE IN LICENSE"
}

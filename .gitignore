# Rust
/target
**/*.rs.bk
Cargo.lock.orig

# Local runtime state
/.nomad
*.log

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Vendored trees: never commit dependencies or build output
vendor/**/node_modules/
vendor/**/production/
vendor/**/dist/
vendor/**/data/
vendor/**/lib/*.exe


# Generated local YSMViewer parser runtime
vendor/kamucl/ysm-engine/**/bin/
vendor/kamucl/ysm-engine/**/obj/
vendor/kamucl/ysm-runtime/viewer/

# Prevent known accidental root artifacts
/*.png
/*.jpg
/*.jpeg
/%PROGRAMDATA%/
/NVIDIA Corporation/

# Project documentation stays local
/docs/

/apps/numen-adapter/build/
/apps/numen-adapter/dist/
/apps/numen-adapter/.cache/

/apps/gateway/build/
/apps/gateway/dist/
/apps/gateway/.cache/
